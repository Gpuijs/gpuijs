{
  "name": "gpuijs",
  "version": "0.1.0",
  "description": "React, Vue and Solid apps rendered natively by GPUI",
  "homepage": "https://gpuijs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gpuijs/gpuijs.git",
    "directory": "js"
  },
  "bugs": "https://github.com/Gpuijs/gpuijs/issues",
  "keywords": [
    "gpui",
    "react",
    "vue",
    "solid",
    "desktop",
    "native",
    "macos"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.js"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./env": "./src/env.js",
    "./react": "./src/react.js",
    "./vue": "./src/vue.js",
    "./solid": "./src/solid.js"
  },
  "main": "src/index.js",
  "bin": {
    "gpuijs": "bin/gpuijs.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tailwindcss/cli": "^4",
    "react-reconciler": "0.34.0",
    "tailwindcss": "^4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "solid-js": "^1.9",
    "vue": "^3.5"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.1"
  },
  "optionalDependencies": {
    "gpuijs-darwin-arm64": "0.1.0",
    "gpuijs-darwin-x64": "0.1.0"
  }
}
